{
  "name": "agentsws",
  "private": true,
  "version": "0.0.0",
  "description": "开源本地跨境电商 Agent 中台（DeepSeek Harness 发行版）",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Luoye-W/agentsws#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luoye-W/agentsws.git"
  },
  "bugs": {
    "url": "https://github.com/Luoye-W/agentsws/issues"
  },
  "author": "agentsws contributors",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.13.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "simulate": "node apps/cli/bin/agentsws.mjs simulate",
    "soak": "node apps/cli/bin/agentsws.mjs simulate --tier soak",
    "realistic": "node apps/cli/bin/agentsws.mjs simulate --tier realistic",
    "synth": "node apps/cli/bin/agentsws.mjs synth",
    "replay": "node apps/cli/bin/agentsws.mjs replay",
    "dev:demo": "tsc -b && pnpm --filter @agentsws/workstation exec vite build && node apps/cli/bin/agentsws.mjs demo",
    "desktop": "pnpm --filter @agentsws/desktop start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
