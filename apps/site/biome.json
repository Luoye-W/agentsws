{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!dist", "!.astro", "!dist-types"]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
