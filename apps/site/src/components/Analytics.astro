---
/**
 * WP477（决策 1609 / 1611 选 A）：官网统计——Google Analytics 4 + Consent Mode v2 + 底部一条小横幅。
 *
 * - 所有访客都先是「不存 Cookie」：`analytics_storage` / `ad_*` 一律 denied，GA 只做不存 Cookie 的粗计数；
 * - 点「允许统计」才把 `analytics_storage` 改成 granted（广告类永远不开）；选择存在本机（localStorage），
 *   页脚「统计设置」与隐私政策里的链接（`#consent`）能随时改主意；
 * - 只在正式域名上加载 gtag（`GA4_HOSTS`），本机预览一个统计请求都不发；
 * - 下载按钮、注册入口的点击报成固定事件名（`download_click`、`signup_click`），给「官网 → 下载」那段漏斗。
 *
 * 逻辑在 `../scripts/analytics.ts`；这里只放横幅（默认藏着，脚本认出「还没选过」才露出来）。
 */
import { GA4_HOSTS, GA4_MEASUREMENT_ID } from '../config.js'
import { type Lang, localePath } from '../i18n/common.js'
import { CONSENT } from '../i18n/consent.js'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = CONSENT[lang]
---
<div class="consent" data-consent data-ga-id={GA4_MEASUREMENT_ID} data-ga-hosts={GA4_HOSTS.join(',')} role="region" aria-label={t.label} hidden>
  <span class="consent-icon" aria-hidden="true">🍪</span>
  <div class="consent-body">
    <p class="consent-title">{t.title}</p>
    <p class="consent-text">{t.text} <a href={localePath('/privacy/', lang)}>{t.policy}</a></p>
  </div>
  <div class="consent-btns">
    <button type="button" class="btn btn-ghost btn-sm" data-consent-choice="denied">{t.deny}</button>
    <button type="button" class="btn btn-primary btn-sm" data-consent-choice="granted">{t.allow}</button>
  </div>
</div>
<script>
  import '../scripts/analytics.ts'
</script>
<style>
  /* 10-23 Luoye：原来的浅色横幅像网站的一部分，容易忽略——改成深色浮卡 + 标题 + 滑入；「不允许」与「允许」一样好点 */
  .consent {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    z-index: 60;
    width: min(760px, calc(100vw - 32px));
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 18px 18px 20px;
    border-radius: 16px;
    background: #14231e;
    color: #f4f6f3;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32), 0 2px 8px rgba(0, 0, 0, 0.18);
    font-size: 14px;
    line-height: 1.5;
    animation: consent-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes consent-in {
    from { opacity: 0; transform: translate(-50%, 24px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent { animation: none; }
  }
  .consent[hidden] {
    display: none;
  }
  .consent-icon {
    font-size: 28px;
    line-height: 1;
    flex-shrink: 0;
  }
  .consent-body {
    flex: 1;
    min-width: 0;
  }
  .consent-title {
    margin: 0 0 2px;
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
  }
  .consent-text {
    margin: 0;
    color: rgba(244, 246, 243, 0.78);
  }
  .consent-text a {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .consent-btns {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .consent-btns .btn-ghost {
    background: transparent;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }
  .consent-btns .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  @media (max-width: 600px) {
    .consent {
      flex-wrap: wrap;
      gap: 12px;
      padding: 16px;
      bottom: 12px;
    }
    .consent-btns {
      width: 100%;
    }
    .consent-btns .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
