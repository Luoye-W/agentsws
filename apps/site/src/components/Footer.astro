---
import {
  ARCHITECTURE_URL,
  accountUrl,
  CONTACT_EMAIL,
  CONTRIBUTING_URL,
  GITHUB_URL,
  OPERATOR_LEGAL_NAME,
  SECURITY_URL,
  TRADEMARK_URL,
} from '../config.js'
import { COMMON, type Lang, localePath } from '../i18n/common.js'
import { CONSENT } from '../i18n/consent.js'
import Mark from './Mark.astro'

interface Props {
  lang: Lang
  path: string
}
const { lang, path } = Astro.props
const c = COMMON[lang]
const f = c.footer
const p = (x: string) => localePath(x, lang)
const colon = lang === 'zh' ? '：' : ': '
type Link = readonly [string, string]
// WP347（Luoye 10-15）：「产品」一栏补齐下载、GitHub、登录 / 注册、积分与充值、更新日志；别的栏不再重复这几样
const cols: { h: string; items: (Link | readonly [Link, Link])[] }[] = [
  {
    h: f.product,
    items: [
      [f.roles, p('/roles/')],
      [f.pricing, p('/pricing/')],
      [f.download, p('/download/')],
      [f.extension, `${p('/download/')}#more`],
      [f.github, GITHUB_URL],
      [
        [f.login, accountUrl('login', lang)],
        [f.signup, accountUrl('signup', lang)],
      ],
      [f.topup, accountUrl('topup', lang)],
      [f.changelog, p('/changelog/')],
    ],
  },
  {
    h: f.resources,
    items: [
      [f.docs, p('/docs/')],
      [f.architecture, ARCHITECTURE_URL],
      [f.contributing, CONTRIBUTING_URL],
      [f.security, SECURITY_URL],
    ],
  },
  {
    h: f.legal,
    items: [
      [f.terms, p('/terms/')],
      [f.privacy, p('/privacy/')],
      [f.refund, p('/refund/')],
      // WP477（决策 1611）：随时改「允许 / 不允许统计」（点了在当前页打开底部那条横幅）
      [CONSENT[lang].settings, '#consent'],
    ],
  },
]
const isPair = (x: Link | readonly [Link, Link]): x is readonly [Link, Link] => Array.isArray(x[0])
const rel = (href: string) => (href.startsWith('http') ? 'noopener' : undefined)
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="logo" href={p('/')}><Mark id="foot" kind="static" />{c.brand}</a>
        <p class="tagline">{c.tagline}</p>
      </div>
      {cols.map((col) => (
        <div>
          <h2>{col.h}</h2>
          <ul>{col.items.map((it) => isPair(it)
            ? <li><a href={it[0][1]} rel={rel(it[0][1])}>{it[0][0]}</a> / <a href={it[1][1]} rel={rel(it[1][1])}>{it[1][0]}</a></li>
            : <li><a href={it[1]} rel={rel(it[1])}>{it[0]}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="foot-operator">
      {!OPERATOR_LEGAL_NAME.startsWith('{{') && <span>{f.operator}{colon}{OPERATOR_LEGAL_NAME}</span>}
      <span>{f.contact}{colon}<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
    </p>
    <div class="foot-bottom">
      <span>{f.bottom.split(f.trademark)[0]}<a href={TRADEMARK_URL} rel="noopener">{f.trademark}</a>{f.bottom.split(f.trademark)[1] ?? ''}</span>
      <span><a href={localePath(path, 'zh')} lang="zh-CN">中文</a> · <a href={localePath(path, 'en')} lang="en">English</a></span>
    </div>
  </div>
</footer>
