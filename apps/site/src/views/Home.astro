---
/**
 * 首页（照 docs/design/site/home.html 方向 A；10-23 按界面优化定稿重排，私有 docs/117）：
 * 首屏 → 一天怎么过（截图滑动）→ 岗位 → 几句话交代（按组点开）→ 出卡审批 → 接上 AI → 上网与浏览器
 * → 本地优先（三种用法、别处收费点开）→ 为什么（四级台阶）→ 底座 → 公开地做 → 常见问题 → 收尾。
 * 页面长度定住：以后加新功能只在「几句话交代」对应那组加一行（`HOME.how.groups`），不加新段。
 * 工作台截图由 `scripts/app-shots.mjs` 从演示世界重拍。
 */
import { Image } from 'astro:assets'
import answerDark from '../assets/app/answer-dark.png'
import answerLight from '../assets/app/answer-light.png'
import calendarLight from '../assets/app/calendar-light.png'
import darkShot from '../assets/app/home-dark.png'
import homeShot from '../assets/app/home-light.png'
import inboxDark from '../assets/app/inbox-dark.png'
import inboxLight from '../assets/app/inbox-light.png'
import onboardingAi from '../assets/app/onboarding-ai-card.png'
import roleSupport from '../assets/app/role-support.png'
import DownloadButton from '../components/DownloadButton.astro'
import Hint from '../components/Hint.astro'
import Icon from '../components/Icon.astro'
import Mark from '../components/Mark.astro'
import { ARCHITECTURE_URL, GITHUB_URL, SISTER_SITES } from '../config.js'
import { type Lang, localePath } from '../i18n/common.js'
import { HOME } from '../i18n/home.js'
import { ROLES } from '../i18n/roles.js'
import Base from '../layouts/Base.astro'
import { loadChangelog } from '../lib/changelog.js'
import { emph, linkNames } from '../lib/locales.js'
import { homeLd } from '../lib/schema.js'
import '../styles/home.css'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang]
const roles = ROLES[lang]
const p = (x: string) => localePath(x, lang)
/** 「一天怎么过」每张图：有深色的给一对，没有的深色下也用浅色那张 */
const tourShots: Record<string, { light: ImageMetadata; dark?: ImageMetadata; bar: string }> = {
  inbox: { light: inboxLight, dark: inboxDark, bar: t.tour.slides[0]?.tab ?? '' },
  calendar: { light: calendarLight, bar: t.tour.slides[1]?.tab ?? '' },
  role: { light: roleSupport, bar: roles[0]?.name ?? '' },
  answer: { light: answerLight, dark: answerDark, bar: roles.find((r) => r.id === 'store')?.name ?? '' },
  home: { light: homeShot, dark: darkShot, bar: t.hero.frameBar },
}
const guideHref = (slug: string) => p(`/docs/${slug}/`)
const logs = loadChangelog(lang).slice(0, 6)
const shotSizes = '(max-width: 900px) calc(100vw - 40px), 680px'
---
<Base lang={lang} path="/" title={t.meta.title} description={t.meta.description} og="home" announce jsonLd={homeLd(lang, t.meta.description)}>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="pill"><i></i>{t.hero.pill}</span>
        <h1>{t.hero.title.map((line) => <span set:html={emph(line)} />)}</h1>
        <p class="lede"><b class="position">{t.hero.position}</b>{t.hero.lede}</p>
        <div class="cta-row">
          <DownloadButton lang={lang} />
          <a class="btn btn-ghost" href={GITHUB_URL} rel="noopener"><Icon name="github" />{t.hero.github}</a>
        </div>
        <p class="dl-more"><a href={`${p('/download/')}#os`}>{t.hero.dlMore[0]}</a> · <a href={`${p('/download/')}#more`}>{t.hero.dlMore[1]}</a></p>
        <p class="dl-win-note" data-dl-note="mac" hidden>{t.hero.macFirstOpen}</p>
        <p class="dl-win-note" data-dl-note="win" hidden>{t.hero.winFirstOpen}</p>
        <ul class="checks">
          {t.hero.checks.map((c) => <li><Icon name="check" />{c}</li>)}
        </ul>
      </div>
      <div class="shot">
        <div class="big-mark"><Mark id="hero" pose="assemble" idle /></div>
        <div class="frame">
          <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{t.hero.frameBar}</span></div>
          <div class="frame-img">
            <Image class="only-light" src={homeShot} alt={t.hero.shotAlt} width={1360} height={820} fit="cover" position="top" widths={[680, 1020, 1360]} sizes={shotSizes} loading="eager" fetchpriority="high" />
            <Image class="only-dark" src={darkShot} alt={t.hero.shotAlt} width={1360} height={820} fit="cover" position="top" widths={[680, 1020, 1360]} sizes={shotSizes} loading="lazy" />
          </div>
        </div>
        <div class="float-card" aria-hidden="true">
          <div class="dcard sel">
            <div class="dcard-h"><span class="chip info">{t.hero.card.chip}</span><span class="chip warn">{t.hero.card.due}</span><span class="chip plain end">{t.hero.card.evidence}</span></div>
            <div class="dcard-b"><h4>{t.hero.card.title}</h4><div class="quote" lang="en">{t.hero.card.quote}</div></div>
            <div class="dcard-f"><span>{t.hero.card.send}</span><span>{t.hero.card.edit}</span><span>{t.hero.card.drop}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tour" id="tour" aria-labelledby="tour-h">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t.tour.eyebrow}</div>
        <h2 class="h2" id="tour-h">{t.tour.title}</h2>
        <p class="sub">{t.tour.sub}</p>
      </div>
      <div class="slider" data-slider>
        <div class="slider-tabs" role="tablist" aria-label={t.tour.eyebrow}>
          {t.tour.slides.map((s, i) => <a class="slider-tab" role="tab" href={`#tour-${s.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-go={i}>{s.tab}</a>)}
        </div>
        <div class="slides" data-track>
          {t.tour.slides.map((s, i) => {
            const shot = tourShots[s.key]
            return (
              <figure class="slide" id={`tour-${s.key}`}>
                <div class="frame">
                  <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{shot?.bar}</span></div>
                  <div class="frame-img">
                    {shot && <Image class:list={[{ 'only-light': shot.dark !== undefined }]} src={shot.light} alt={s.alt} width={1360} height={820} fit="cover" position="top" widths={[680, 1020, 1360]} sizes="(max-width: 900px) calc(100vw - 40px), 880px" loading={i === 0 ? 'eager' : 'lazy'} />}
                    {shot?.dark && <Image class="only-dark" src={shot.dark} alt={s.alt} width={1360} height={820} fit="cover" position="top" widths={[680, 1020, 1360]} sizes="(max-width: 900px) calc(100vw - 40px), 880px" loading="lazy" />}
                  </div>
                </div>
                <figcaption><b>{s.tab}</b>{s.p}</figcaption>
              </figure>
            )
          })}
        </div>
        <div class="slider-nav">
          <button type="button" class="slider-btn" data-step="-1" aria-label={t.tour.prev}>‹</button>
          <span class="slider-dots" aria-hidden="true">{t.tour.slides.map(() => <i></i>)}</span>
          <button type="button" class="slider-btn" data-step="1" aria-label={t.tour.next}>›</button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="roles" aria-labelledby="roles-h">
    <div class="wrap center">
      <div class="eyebrow">{t.roles.eyebrow}</div>
      <h2 class="h2" id="roles-h">{t.roles.title}</h2>
      <p class="sub">{t.roles.sub}</p>
      <ul class="roles">
        {roles.map((r) => (
          <li>
            <a class="role" href={`${p('/roles/')}#${r.id}`}>
              <div class="role-ic"><Icon name={r.icon} /></div>
              <h3>{r.name}{r.isNew && <span class="new">{t.roles.newBadge}</span>}</h3>
              <p>{r.line}</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="role-more">{t.roles.more}<a href={p('/roles/')}>{t.roles.moreLink}</a></p>
    </div>
  </section>

  <section class="sec" id="how" aria-labelledby="how-h">
    <div class="wrap center">
      <div class="eyebrow">{t.how.eyebrow}</div>
      <h2 class="h2" id="how-h">{t.how.title}</h2>
      <p class="sub">{t.how.sub}</p>
      <div class="feat-groups" data-tabs>
        <div class="feat-tabs" role="tablist" aria-label={t.how.eyebrow}>
          {t.how.groups.map((g, i) => <button type="button" class="feat-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`how-${g.key}`} data-tab={i}>{g.label}</button>)}
        </div>
        {t.how.groups.map((g) => (
          <div class="feat-panel" id={`how-${g.key}`} role="tabpanel" aria-label={g.label} data-panel>
            <h3 class="feat-label">{g.label}</h3>
            <div class="feats">
              {g.items.map((it) => (
                <details class="feat">
                  <summary><b>{it.h}</b><span>{it.p}</span></summary>
                  <p>{it.more}{it.help !== '' && <> <a href={guideHref(it.help)}>{t.how.guide}</a></>}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="cards" aria-labelledby="cards-h">
    <div class="wrap center">
      <div class="eyebrow">{t.cards.eyebrow}</div>
      <h2 class="h2" id="cards-h">{t.cards.title}</h2>
      <p class="sub">{t.cards.sub}</p>
      <ol class="rail" style="--n:5">
        {t.cards.steps.map(([h, d], i) => (
          <li class:list={['step', { on: i === 2 || i === 3 }]}><div class="n" aria-hidden="true">{i + 1}</div><h3>{h}</h3><p>{d}</p></li>
        ))}
      </ol>
      <div class="deck">
        {t.cards.deck.map((c, i) => (
          <div class:list={['dcard', { sel: i === 1 }]}>
            <div class="dcard-h"><span class:list={['chip', c.tone]}>{c.chip}</span><span class:list={['chip', i === 1 ? 'plain end' : 'warn']}>{c.due}</span></div>
            <div class="dcard-b">
              <h4>{c.title}</h4>
              <div class="quote">{c.body}</div>
            </div>
            <div class="dcard-f" aria-hidden="true">{c.actions.map((a) => <span>{a}</span>)}</div>
          </div>
        ))}
      </div>
      <p class="never"><Icon name="shield" />{t.cards.never}</p>
    </div>
  </section>

  <section class="sec" id="ai" aria-labelledby="ai-h">
    <div class="wrap ai">
      <div>
        <div class="eyebrow">{t.ai.eyebrow}</div>
        <h2 class="h2" id="ai-h">{t.ai.title}</h2>
        <p class="sub">{t.ai.sub}</p>
        <ul class="ai-opts">
          {t.ai.options.map((o) => (
            <li><a class:list={['ai-opt', { own: o.own }]} href={guideHref(o.help)}><b>{o.h}</b><span>{o.p}</span></a></li>
          ))}
        </ul>
        <details class="ai-price" id="credits">
          <summary>{t.ai.price.summary}</summary>
          <p>{t.ai.price.p} <a href={p('/pricing/')}>{t.ai.price.link}</a></p>
        </details>
      </div>
      <div class="frame ai-shot">
        <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{t.ai.frameBar}</span></div>
        <div class="frame-img"><Image src={onboardingAi} alt={t.ai.shotAlt} width={1408} height={952} widths={[704, 1056, 1408]} sizes="(max-width: 900px) calc(100vw - 40px), 620px" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="web" aria-labelledby="web-h">
    <div class="wrap center">
      <div class="eyebrow">{t.web.eyebrow}</div>
      <h2 class="h2" id="web-h">{t.web.title}</h2>
      <p class="sub web-sub">{t.web.sub}</p>
      <div class="feats feats-3">
        {t.web.items.map((it) => (
          <details class="feat">
            <summary><b>{it.h}</b><span>{it.p}</span></summary>
            <p>{it.more} <a href={guideHref(it.help)}>{t.web.guide}</a></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="local" aria-labelledby="local-h">
    <div class="wrap">
      <div class="local">
        <div>
          <div class="eyebrow">{t.local.eyebrow}</div>
          <h2 class="h2" id="local-h">{t.local.title.map((l, i) => <>{l}{i === 0 && <br />}</>)}</h2>
          <p class="sub">{t.local.sub}</p>
        </div>
        <div class="promises">
          {t.local.promises.map((pr) => (
            <div class="promise">
              <div class="role-ic"><Icon name={pr.icon as 'laptop'} /></div>
              <h3>{pr.h}{'hint' in pr && pr.hint !== undefined && <Hint text={pr.hint} />}</h3>
              <p>{pr.p}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="more-rows">
        <details class="more" id="modes">
          <summary>{t.modes.summary}</summary>
          <ol class="modes">
            {t.modes.items.map((m) => (
              <li class:list={['mode', `mode-${m.key}`]}>
                <span class="mode-tag">{m.tag}</span>
                <h3>{m.h}</h3>
                <p>{m.p}</p>
              </li>
            ))}
          </ol>
          <p class="modes-grow"><Icon name="arrow" />{t.modes.grow}</p>
        </details>
        <details class="more" id="free">
          <summary>{t.free.summary}</summary>
          <p class="more-sub">{t.free.sub}</p>
          <table class="cmp">
            <thead><tr>{t.free.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {t.free.rows.map(([k, them, us]) => (
                <tr><th scope="row">{k}</th><td class="them">{them}</td><td class="us"><Icon name="check" />{us}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="fine">{t.free.fine}</p>
        </details>
        <details class="more">
          <summary>{t.local.usage[0]}</summary>
          <p class="more-sub">{t.local.usage[1]}</p>
        </details>
      </div>
    </div>
  </section>

  <section class="sec sec-alt why" id="why" aria-labelledby="why-h">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t.why.eyebrow}</div>
        <h2 class="h2" id="why-h">{t.why.title.map((l, i) => <>{l}{i < t.why.title.length - 1 && <br />}</>)}</h2>
        <p class="sub">{t.why.sub}</p>
      </div>
      <ol class="stairs" id="stairs">
        <li class="stair">
          <div class="scene s1" aria-hidden="true">
            <div class="dash">
              <div class="dash-h"><i></i><i></i><i></i><span>{t.why.s1.board}</span></div>
              <div class="kpis"><div><b class="c1">1,284</b><small>{t.why.s1.kpi[0]}</small></div><div><b class="c2">$42k</b><small>{t.why.s1.kpi[1]}</small></div><div><b class="c3">3.1%</b><small>{t.why.s1.kpi[2]}</small></div></div>
              <svg class="spark" viewBox="0 0 200 48" preserveAspectRatio="none"><path d="M0 40 L25 33 L50 36 L75 22 L100 27 L125 13 L150 19 L175 8 L200 12" /></svg>
              <div class="bars"><i style="height:45%"></i><i style="height:70%"></i><i style="height:52%"></i><i style="height:88%"></i><i style="height:64%"></i><i style="height:35%"></i></div>
            </div>
            <div class="dust"></div>
            <span class="stale">{t.why.s1.stale}</span>
          </div>
          <div class="stair-txt"><span class="lv">01</span><h3>{t.why.steps[0]?.h}</h3><p>{t.why.steps[0]?.p}</p></div>
        </li>
        <li class="stair">
          <div class="scene s2" aria-hidden="true">
            <div class="tool">
              <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg><span>{t.why.s2.search}</span></div>
              <div class="tbl">
                <div class="tr th">{t.why.s2.cols.map((c) => <span>{c}</span>)}</div>
                <div class="tr r1"><span>@trailsun</span><span>48k</span><span>—</span></div>
                <div class="tr r2"><span>@desknoor</span><span>31k</span><span>—</span></div>
                <div class="tr r3"><span>@gadgetjo</span><span>26k</span><span>—</span></div>
              </div>
              <div class="tool-f"><span>{t.why.s2.row}</span><b class="csv">{t.why.s2.csv}</b></div>
            </div>
            <svg class="hand" viewBox="0 0 24 24"><path d="M18 11V6a2 2 0 0 0-4 0v0" /><path d="M14 10V4a2 2 0 0 0-4 0v2" /><path d="M10 10.5V6a2 2 0 0 0-4 0v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-6-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></svg>
          </div>
          <div class="stair-txt"><span class="lv">02</span><h3>{t.why.steps[1]?.h}</h3><p>{t.why.steps[1]?.p}</p></div>
        </li>
        <li class="stair">
          <div class="scene s3" aria-hidden="true">
            <div class="s3-h"><span class="tag">KOLAgents</span><Mark id="breathe" pose="breathe" leadOnly /><small>{t.why.s3.working}</small></div>
            <div class="chain">
              <div class="node n1"><i></i><b>{t.why.s3.nodes[0]?.[0]}</b><small>{t.why.s3.nodes[0]?.[1]}</small></div>
              <div class="link l1"></div>
              <div class="node n2"><i></i><b>{t.why.s3.nodes[1]?.[0]}</b><small>{t.why.s3.nodes[1]?.[1]}</small></div>
              <div class="link l2"></div>
              <div class="node n3"><i></i><b>{t.why.s3.nodes[2]?.[0]}</b><small>{t.why.s3.nodes[2]?.[1]}</small></div>
            </div>
            <div class="learn"><span class="lbadge">{t.why.s3.learn}</span><p>{t.why.s3.note}</p></div>
          </div>
          <div class="stair-txt"><span class="lv">03</span><h3>{t.why.steps[2]?.h}</h3><p set:html={linkNames(t.why.steps[2]?.p ?? '', SISTER_SITES)} /></div>
        </li>
        <li class="stair">
          <div class="scene s4" aria-hidden="true">
            <svg class="team" viewBox="0 0 260 200">
              <defs><marker id="ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 8 4 0 8Z" class="ah" /></marker></defs>
              <foreignObject x="10" y="8" width="26" height="26" class="team-mark"><Mark id="team" /></foreignObject>
              <text x="42" y="26" class="t-mute">{t.why.s4.split}</text>
              <g class="t-role r1"><rect x="22" y="46" width="98" height="38" rx="8" /><circle cx="34" cy="59" r="3.5" class="d-info" /><text x="43" y="62" class="t-b">{t.why.s4.roles[0]?.[0]}</text><text x="31" y="77" class="t-s">{t.why.s4.roles[0]?.[1]}</text></g>
              <g class="t-role r2"><rect x="22" y="94" width="98" height="38" rx="8" /><circle cx="34" cy="107" r="3.5" class="d-good" /><text x="43" y="110" class="t-b">{t.why.s4.roles[1]?.[0]}</text><text x="31" y="125" class="t-s">{t.why.s4.roles[1]?.[1]}</text></g>
              <g class="t-role r3"><rect x="22" y="142" width="98" height="38" rx="8" /><circle cx="34" cy="155" r="3.5" class="d-warn" /><text x="43" y="158" class="t-b">{t.why.s4.roles[2]?.[0]}</text><text x="31" y="173" class="t-s">{t.why.s4.roles[2]?.[1]}</text></g>
              <path class="hand-off" d="M22 70 C4 72 4 156 20 160" marker-end="url(#ah)" />
              <text x="1" y="118" class="t-hand">{t.why.s4.handoff}</text>
              <path class="arrow a1" d="M120 65 C140 65 140 96 156 100" marker-end="url(#ah)" />
              <path class="arrow a2" d="M120 113 C136 113 140 110 156 110" marker-end="url(#ah)" />
              <path class="arrow a3" d="M120 161 C140 161 140 124 156 120" marker-end="url(#ah)" />
              <g class="decide"><rect x="158" y="62" width="94" height="100" rx="10" class="dk" /><text x="168" y="82" class="t-brand">{t.why.s4.decide}</text><text x="168" y="102" class="t-b">{t.why.s4.quote}</text><text x="168" y="118" class="t-s">{t.why.s4.amount}</text><rect x="168" y="130" width="42" height="20" rx="6" class="btn-ok" /><text x="178" y="144" class="t-ok">{t.why.s4.approve}</text></g>
            </svg>
          </div>
          <div class="stair-txt"><span class="lv">04</span><h3>{t.why.steps[3]?.h}</h3><p>{t.why.steps[3]?.p}</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="sec base" id="base" aria-labelledby="base-h">
    <div class="wrap">
      <div class="base-head">
        <div class="eyebrow">{t.base.eyebrow}</div>
        <h2 class="h2" id="base-h">{t.base.title.map((l, i) => <><span set:html={emph(l)} />{i === 0 && <br />}</>)}</h2>
        <p class="sub">{t.base.sub}</p>
      </div>
      <div class="base-grid">
        <div class="stack" role="img" aria-label={t.base.stackLabel}>
          <div class="lay team-l"><span class="ln">{t.base.team}</span><ul class="chips">{t.base.teamChips.map((c) => <li>{c}</li>)}</ul></div>
          <div class="five">
            <span class="five-label">{t.base.rebuilt}</span>
            {t.base.layers.map(([n, d]) => <div class="lay"><span class="ln">{n}</span><p>{d}</p></div>)}
          </div>
          <div class="lay harness"><span class="ln">{t.base.harness[0]}</span><p>{t.base.harness[1]}</p></div>
        </div>
        <div class="upd">
          <details class="upd-more">
            <summary><h3>{t.base.updTitle} <span class="ar" aria-hidden="true">→</span> {t.base.updTitle2} <span class="upd-n">{t.base.timeline.length}</span></h3></summary>
            <ol class="tl">
              {t.base.timeline.map(([d, h, s]) => <li><time datetime={d}>{d}</time><b>{h}</b><span>{s}</span></li>)}
            </ol>
          </details>
          <div class="oss">
            <p><b>{t.base.oss[0]}</b>{t.base.oss[1]}</p>
            <div class="cta-row" style="margin:0">
              <a class="btn btn-primary" href={GITHUB_URL} rel="noopener"><Icon name="github" />{t.base.star}</a>
              <a class="btn btn-ghost" href={ARCHITECTURE_URL} rel="noopener">{t.base.arch}</a>
            </div>
          </div>
          <div class="term" aria-hidden="true">
            <div class="term-bar"><i></i><i></i><i></i></div>
            <pre><span class="t-dim">$</span> <span class="t-hi">pnpm simulate --pack packs/dtc-3c-3p</span>
<span class="t-ok">PASS</span>  {t.base.term[0]}
<span class="t-dim">  {t.base.term[1]}</span></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="log" aria-labelledby="log-h">
    <div class="wrap center">
      <div class="eyebrow">{t.log.eyebrow}</div>
      <h2 class="h2" id="log-h">{t.log.title}</h2>
      <p class="sub">{t.log.sub}</p>
      <ul class="logs">
        {logs.map((l) => (
          <li><a class="log" href={`${p('/changelog/')}#${l.id}`}><time datetime={l.date}>{l.date.slice(5)}</time><h3>{l.title}</h3><p>{l.summary}</p></a></li>
        ))}
      </ul>
      <p class="logs-all"><a href={p('/changelog/')}>{t.log.all}</a></p>
    </div>
  </section>

  <section class="sec sec-alt" id="faq" aria-labelledby="faq-h">
    <div class="wrap center">
      <h2 class="h2" id="faq-h">{t.faq.title}</h2>
      <div class="faq faq-2">
        {t.faq.items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <Mark id="final" kind="static" />
      <h2>{t.final.title}</h2>
      <p class="sub" style="margin:0 auto">{t.final.sub}</p>
      <div class="cta-row">
        <DownloadButton lang={lang} />
        <a class="btn btn-ghost" href={p('/docs/')}>{t.final.docs}</a>
      </div>
      <p class="dl-win-note" data-dl-note="mac" hidden>{t.hero.macFirstOpen}</p>
      <p class="dl-win-note" data-dl-note="win" hidden>{t.hero.winFirstOpen}</p>
    </div>
  </section>
</Base>
