---
/** 文档区目录：按 `HELP_SLUGS` 的顺序，按前缀分几组摆（只是摆法，不改顺序）。 */
import { type Lang, localePath } from '../i18n/common.js'
import { PAGES } from '../i18n/pages.js'
import Base from '../layouts/Base.astro'
import { helpGroup, helpSlugs, loadHelp } from '../lib/help.js'
import { docHref } from '../lib/markdown.js'
import '../styles/pages.css'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = PAGES[lang].docs
const docs = helpSlugs().map((s) => loadHelp(s, lang))
const order = ['start', 'models', 'connect', 'channels', 'tools'] as const
---
<Base lang={lang} path="/docs/" title={t.meta.title} description={t.meta.description} og="docs" current="docs">
  <section class="page-hero" style="padding-bottom:88px">
    <div class="wrap center">
      <div class="eyebrow">{t.eyebrow}</div>
      <h1 class="page-h1">{t.title}</h1>
      <p class="sub">{t.sub}</p>
      <div class="doc-index">
        {order.map((g) => {
          const list = docs.filter((d) => helpGroup(d.slug) === g)
          return list.length === 0 ? null : (
            <div>
              <h2>{t.groups[g]}</h2>
              <ul class="doc-cards">
                {list.map((d) => <li><a href={docHref(d.slug, lang)}><h3>{d.title}</h3><p>{d.summary}</p></a></li>)}
              </ul>
            </div>
          )
        })}
      </div>
    </div>
  </section>
</Base>
