{
  "name": "@agentsws/server",
  "version": "0.0.0",
  "private": true,
  "description": "协同服务进程（装配全部模块）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentsws-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentsws/api": "workspace:*",
    "@agentsws/blob": "workspace:*",
    "@agentsws/channels": "workspace:*",
    "@agentsws/connect-adapter": "workspace:*",
    "@agentsws/contracts": "workspace:*",
    "@agentsws/core": "workspace:*",
    "@agentsws/data": "workspace:*",
    "@agentsws/deck": "workspace:*",
    "@agentsws/kernel": "workspace:*",
    "@agentsws/knowledge": "workspace:*",
    "@agentsws/learning": "workspace:*",
    "@agentsws/meetings": "workspace:*",
    "@agentsws/model-gateway": "workspace:*",
    "@agentsws/roles": "workspace:*",
    "@agentsws/runtime-direct": "workspace:*",
    "@agentsws/schedule": "workspace:*",
    "@agentsws/skills": "workspace:*",
    "@agentsws/stand-ins": "workspace:*",
    "@agentsws/txn": "workspace:*",
    "@agentsws/work": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.13.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.5.13"
  }
}
