    "@agentsws/data": "workspace:*",
    "@agentsws/deck": "workspace:*",
    "@agentsws/kernel": "workspace:*",
    "@agentsws/knowledge": "workspace:*",
    "@agentsws/meetings": "workspace:*",
    "@agentsws/model-gateway": "workspace:*",
    "@agentsws/roles": "workspace:*",
    "@agentsws/skills": "workspace:*",
    "@agentsws/txn": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7"
  }
}
