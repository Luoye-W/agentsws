{
  "name": "@agentsws/cloud",
  "version": "0.0.0",
  "private": true,
  "description": "agentsws 云：账号 / 组织 / 工作区服务令牌（49 M1）与服务入口的装配点（M3）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentsws-cloud": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers-kit": {
      "types": "./dist/workers-kit.d.ts",
      "import": "./dist/workers-kit.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && node dist/index.js",
    "start": "node dist/index.js",
    "openapi": "node ../../scripts/gen-cloud-openapi.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentsws/api": "workspace:*",
    "@agentsws/brand": "workspace:*",
    "@agentsws/cloud-entry": "workspace:*",
    "@agentsws/contracts": "workspace:*",
    "@agentsws/core": "workspace:*",
    "@agentsws/hosted": "workspace:*",
    "@agentsws/kol-cloud": "workspace:*",
    "@agentsws/kol-public": "workspace:*",
    "@agentsws/metering": "workspace:*",
    "@agentsws/server": "workspace:*",
    "@agentsws/standby": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.13.7",
    "nodemailer": "^7.0.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^8.0.1"
  }
}
