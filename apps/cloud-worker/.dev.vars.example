# 本地 `wrangler dev` 用的密钥占位（WP114）。
#
# **这个文件里全是空值，而且它是 .example——真值只进 `wrangler secret put`。**
# 要在本机联调就 `cp .dev.vars.example .dev.vars` 再自己填；
# `.dev.vars` 已经在 .gitignore 里，填了也提交不上去。
#
# 每一项是什么、去哪儿拿、必填否，见 docs/64 的 secrets 全表。

# 打模型上游的 key（OpenAI 兼容口，内测期例如 DeepSeek 官方）
AGENTSWS_NEWAPI_KEY=

# 管理员手动发积分那条路由的钥匙。**没配这条路由根本不挂**（不是挂上去再拒）。
# 生成：openssl rand -base64 48
AGENTSWS_CLOUD_ADMIN_TOKEN=

# Stripe（不配就回 501 一句人话，不是 500）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 公共红人库的邮箱密钥（WP116，AES-256-GCM 的 32 字节，hex 或 base64url）。
# **不配就不存邮箱**——一个字节都不写，绝不降级成明文。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENTSWS_KOL_EMAIL_KEY=

# 公共红人库的两个上游（都可选；一个都不配就是"只查库"）
AGENTSWS_YOUTUBE_API_KEY=
APIFY_TOKEN=

# 官方聊天转发的访客令牌种子（WP137，**必填，至少 32 字节**）。
# 没配 = 所有商家网站上的聊天窗一律 503（没有兜底——写死的种子等于任何人都能伪造访客令牌）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENTSWS_CHAT_RELAY_KEY=
