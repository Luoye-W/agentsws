{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.claude",
      "!**/dist",
      "!docs/assets",
      "!**/*.dc.html",
      "!pnpm-lock.yaml",
      "!out",
      "!coverage",
      "!**/out",
      "!**/test-results",
      "!**/playwright-report",
      "!**/release"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
