{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!node_modules",
      "!.claude",
      "!**/dist",
      "!docs/assets",
      "!**/src/assets/brand",
      "!**/*.dc.html",
      "!**/test/fixtures",
      "!pnpm-lock.yaml",
      "!out",
      "!coverage",
      "!**/out",
      "!**/test-results",
      "!**/playwright-report",
      "!**/release",
      "!apps/desktop/vendor"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
