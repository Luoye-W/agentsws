{
  "name": "@agentsws/core",
  "version": "0.0.0",
  "private": true,
  "description": "框架无关纯规则：fencing、gates、guardrail、账本类型；SQL 驱动抽象（SQLite ↔ Postgres）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js"
    },
    "./sql/testing": {
      "types": "./dist/sql/testing.d.ts",
      "import": "./dist/sql/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentsws/contracts": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
