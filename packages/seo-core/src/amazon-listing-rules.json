{
  "$comment": "WP396（docs/106 §13）：自家 Listing 体检规则表。每条带出处（official = Amazon 卖家帮助 / 官方公告；practice = 公开运营资料里的通行做法）与核对日期；params 是建议值，用户能改。规则在变：核对日期过了 180 天，卡上标「这条规则可能过时」。违规宣称那一条按站点用 claim-rules.ts 的市场分组。",
  "rules": [
    {
      "id": "offer.in_stock",
      "area": "offer",
      "check": "in_stock",
      "severity": "blocker",
      "name": {
        "zh": "有没有货",
        "en": "In stock"
      },
      "params": {},
      "source": {
        "kind": "practice",
        "title": "通行做法：前台写「Currently unavailable」就买不了"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "先补货或开自发货；断货太久会掉排名",
        "en": "Restock or add a merchant-fulfilled offer; long stockouts cost ranking"
      },
      "enabled": true
    },
    {
      "id": "offer.buybox_present",
      "area": "offer",
      "check": "buybox_present",
      "severity": "blocker",
      "name": {
        "zh": "购物车（Featured Offer）在不在",
        "en": "Featured Offer shown"
      },
      "params": {},
      "source": {
        "kind": "practice",
        "title": "Amazon 卖家论坛：Featured Offer（购物车）资格说明"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "在后台「库存」里看这条 Listing 的 Featured Offer 资格（价格、配送、账户表现都有关）",
        "en": "Check Featured Offer eligibility for this listing in Seller Central (price, delivery and account performance all matter)"
      },
      "enabled": true
    },
    {
      "id": "offer.buybox_own",
      "area": "offer",
      "check": "buybox_own",
      "severity": "blocker",
      "name": {
        "zh": "购物车是不是你",
        "en": "You own the Featured Offer"
      },
      "params": {},
      "source": {
        "kind": "practice",
        "title": "通行做法：购物车被别的卖家拿走（跟卖），大部分订单不是你的"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "看看是不是被跟卖；是就走品牌保护（这一块在账户健康与合规里）",
        "en": "Check for hijackers; if so, use brand protection (Account health & compliance)"
      },
      "enabled": true
    },
    {
      "id": "title.max_chars",
      "area": "title",
      "check": "title_max_chars",
      "severity": "search",
      "name": {
        "zh": "标题长度",
        "en": "Title length"
      },
      "params": {
        "max_chars": 200
      },
      "source": {
        "kind": "official",
        "title": "Amazon 官方公告：商品标题新要求（2025-01-21 起）",
        "url": "https://sellercentral.amazon.com/seller-forums/discussions/t/533f9cf7-3b5e-4974-b523-02e4a1a42c5f"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "把标题收到建议长度以内：品牌 + 商品是什么 + 最要紧的一两个属性",
        "en": "Trim to the suggested length: brand + what it is + the one or two key attributes"
      },
      "enabled": true
    },
    {
      "id": "title.repeat_words",
      "area": "title",
      "check": "title_repeat_words",
      "severity": "search",
      "name": {
        "zh": "同一个词重复",
        "en": "Repeated words"
      },
      "params": {
        "max_repeat": 2,
        "exempt": [
          "a",
          "an",
          "the",
          "and",
          "or",
          "for",
          "with",
          "of",
          "in",
          "on",
          "to",
          "by",
          "at",
          "from",
          "&",
          "-",
          "–",
          "|"
        ]
      },
      "source": {
        "kind": "official",
        "title": "Amazon 官方公告：商品标题新要求（2025-01-21 起）",
        "url": "https://sellercentral.amazon.com/seller-forums/discussions/t/533f9cf7-3b5e-4974-b523-02e4a1a42c5f"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "同一个词（介词、冠词、连词除外）最多出现建议次数",
        "en": "Use each word (except prepositions, articles and conjunctions) at most the suggested number of times"
      },
      "enabled": true
    },
    {
      "id": "title.special_chars",
      "area": "title",
      "check": "title_special_chars",
      "severity": "search",
      "name": {
        "zh": "标题里的特殊符号",
        "en": "Special characters in title"
      },
      "params": {
        "chars": ["!", "$", "?", "_", "{", "}", "^", "¬", "¦"]
      },
      "source": {
        "kind": "official",
        "title": "Amazon 官方公告：商品标题新要求（2025-01-21 起）",
        "url": "https://sellercentral.amazon.com/seller-forums/discussions/t/533f9cf7-3b5e-4974-b523-02e4a1a42c5f"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "去掉这些符号（是品牌名的一部分除外）",
        "en": "Remove these characters unless they are part of the brand name"
      },
      "enabled": true
    },
    {
      "id": "title.promo_words",
      "area": "title",
      "check": "title_promo_words",
      "severity": "search",
      "name": {
        "zh": "标题里的促销字眼",
        "en": "Promotional words in title"
      },
      "params": {
        "words": [
          "best",
          "best seller",
          "best-selling",
          "#1",
          "no. 1",
          "top rated",
          "free shipping",
          "sale",
          "hot sale",
          "hot deal",
          "limited time",
          "100% guaranteed",
          "cheapest"
        ]
      },
      "source": {
        "kind": "official",
        "title": "Amazon 卖家帮助：商品详情页规则",
        "url": "https://sellercentral.amazon.com/help/hub/reference/external/G202024200"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "标题只写商品本身，促销、排名、包邮这类字眼拿掉",
        "en": "Keep the title about the product; remove promotional, ranking or shipping claims"
      },
      "enabled": true
    },
    {
      "id": "title.all_caps",
      "area": "title",
      "check": "title_all_caps",
      "severity": "improve",
      "name": {
        "zh": "标题全大写",
        "en": "All-caps title"
      },
      "params": {
        "max_upper_ratio": 0.7
      },
      "source": {
        "kind": "practice",
        "title": "Amazon 各类目风格指南通行写法：每个词首字母大写，不全大写"
      },
      "checked_at": "2026-10-18",
      "advice": {
        "zh": "改成每个词首字母大写",
        "en": "Use title case instead of all caps"
      },
      "enabled": true
    },
    {
