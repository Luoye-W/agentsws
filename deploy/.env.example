# agentsws 云侧测试环境的环境变量样板（WP110）。
#
#   cd deploy && cp .env.example .env && chmod 600 .env && vi .env
#
# **这个文件里的值全是空的，而且永远都该是空的。** 仓库是公开的；真密钥
# 只活在服务器上那一份 `.env` 里（`.gitignore` 已经挡掉 `.env`）。
# 逐步怎么填见 `docs/61-云端测试环境部署-v1.md`。
#
# 生成随机串统一用：openssl rand -base64 48

# ── 必填：域名与证书 ────────────────────────────────────────────────────

# 云的域名。DNS 上要有一条 A 记录 cloud → 这台服务器的公网 IP。
CLOUD_DOMAIN=cloud.agentsws.com

# 证书快到期时 Let's Encrypt 往哪里发提醒。填一个你真会看的邮箱。
ACME_EMAIL=

# ── 必填：登录邮件（不配的话进程拒绝启动）──────────────────────────────
#
# 云侧唯一的登录方式是 magic link，所以发不出信 = 没人登得进来。
# 用一家 SMTP 服务商（阿里云邮件推送 / 腾讯云 SES / Resend / Postmark 都行），
# 在它那边把发信域名的 SPF 与 DKIM 配好，否则信会进垃圾箱。
#
# 形如 smtps://用户名:口令@smtp.服务商.com:465
# （口令里有 @ : / 这些字符要 URL 编码）
AGENTSWS_CLOUD_SMTP_URL=

# 发件地址。要用上面那个域名下的地址，不然 SPF 对不上。
# 形如：agentsws <no-reply@agentsws.com>
AGENTSWS_CLOUD_MAIL_FROM=

# 还没配好 SMTP、只想先把服务起起来看看？把下面这行取消注释。
# 代价是**登录链接会被打进容器日志**——谁能看日志谁就能登进任何人的账号。
# 配好 SMTP 之后立刻删掉这一行。
# AGENTSWS_CLOUD_ALLOW_CONSOLE_MAIL=1

# ── 必填：New API 的内部令牌 ────────────────────────────────────────────
#
# 在 New API 后台（经 SSH 隧道打开，docs/61 §4）建一个令牌，把那一串填这里。
# **各家模型的上游 key（DeepSeek / OpenAI / …）不填在这儿**——它们填在
# New API 自己的"渠道"页里，一个都不进这个文件。
AGENTSWS_NEWAPI_KEY=

# New API 的镜像。以它自己 README 上那一行为准；换了就改这里，不用动 compose。
# NEWAPI_IMAGE=ghcr.io/quantumnous/new-api:latest

# ── 选填：管理员口子 ────────────────────────────────────────────────────
#
# 给内测朋友发积分要它（POST /v1/admin/topup，docs/61 §5）。
# **不填这一行，那条路由根本不挂**；填了就必须至少 32 字节，短了进程起不来。
#   openssl rand -base64 48
AGENTSWS_CLOUD_ADMIN_TOKEN=

# ── 选填：公共红人库的外部源（WP61）──────────────────────────────────────
#
# 一个都不配也能起——那就是"只查库"。

# 邮箱密文那把钥匙（公共库里红人的联系邮箱是加密存的）。
# **换了这把钥匙，已经存进去的邮箱就解不出来了**，所以生成一次就别再动。
AGENTSWS_KOL_EMAIL_KEY=

# YouTube Data API 的 key（有它才有官方口）
AGENTSWS_YOUTUBE_API_KEY=

# Apify 的 token（官方口配额用完时的降级路）
APIFY_TOKEN=

# YouTube 一天最多用多少配额单位（不填走默认）
# AGENTSWS_YOUTUBE_UNITS_PER_DAY=

# ── 选填：支付（测试环境不开）────────────────────────────────────────────
#
# 留空 = 充值路由回 501 一句人话。测试期的额度走管理员手动发，见上面那一条。
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── 选填：杂项 ──────────────────────────────────────────────────────────

# 备份保留多少天（deploy/backup.sh）
BACKUP_KEEP_DAYS=14

# 容器时区
TZ=Asia/Shanghai
