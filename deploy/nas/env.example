# 复制成仓库根目录的 .env（chmod 600，别进 git），再跑 deploy/nas/gen-keys.sh 补密钥。
#
#   cp deploy/nas/env.example .env
#   sh deploy/nas/gen-keys.sh >> .env
#   chmod 600 .env

# ── 基本 ────────────────────────────────────────────────────────────────
# 工作区所有者的邮箱（第一次登录用它收邀请链接）
AGENTSWS_OWNER_EMAIL=owner@example.com
AGENTSWS_WORKSPACE_NAME=我的公司

# 数据放哪（宿主机路径）。NAS 上换成共享目录，例如：
#   /volume1/agentsws/data          （群晖）
#   /share/agentsws/data            （威联通）
AGENTSWS_HOST_DATA_DIR=./.agentsws-data

# 对外端口与绑定地址。
# 默认只绑回环 = 只有这台机器能开；要给同事用，换成 NAS 的内网地址（不要写 0.0.0.0 直接暴露到公网）
AGENTSWS_BIND=127.0.0.1
AGENTSWS_HOST_PORT=4317

# ── 存储后端（留空 = SQLite + 本地目录，第一档默认）──────────────────────
# Postgres 档（docker compose --profile postgres up -d 时打开）
# POSTGRES_PASSWORD=换成一个长随机串
# DATABASE_URL=postgres://agentsws:换成同一个串@postgres:5432/agentsws

# 对象存储档（大文件走 S3 兼容；--profile s3 起自带的 MinIO，或指向 NAS 自带的 MinIO / 云上的桶）
# AGENTSWS_BLOB_URL=s3://agentsws/?endpoint=http://minio:9000&region=us-east-1
# AGENTSWS_BLOB_ACCESS_KEY_ID=agentsws
# AGENTSWS_BLOB_SECRET_ACCESS_KEY=换成一个长随机串
